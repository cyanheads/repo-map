# Copy to .env in the directory you run repo-map from, or export these instead.

# Required. Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Any OpenRouter model ID. --model overrides it per run.
OPENROUTER_MODEL_NAME=anthropic/claude-sonnet-5.5

# Concurrent API calls, 1 or greater. --concurrency overrides it per run.
API_SEMAPHORE_LIMIT=3
